rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app's creator (verified email only) can read every family's progress for the Creator dashboard.
    function isCreator() {
      return request.auth != null
        && request.auth.token.email == 'danielbhwang@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Each family's own saves: only that family can read or write. The creator can read.
    match /families/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isCreator();
    }
    // Creator dashboard reads every family's "rq" documents in one query.
    match /{path=**}/rq/{docId} {
      allow read: if isCreator();
    }
    // Big World: one small public card per hero. Any signed-in family can see it,
    // but only the family that owns it can create, change or delete it.
    match /world/{docId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && docId.matches(request.auth.uid + '_[A-Za-z0-9_-]+');
      allow create, update: if request.auth != null
        && docId == request.auth.uid + '_' + request.resource.data.pid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'pid', 'name', 'json', 'ts'])
        && request.resource.data.pid is string && request.resource.data.pid.matches('[A-Za-z0-9_-]{1,40}')
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.json is string && request.resource.data.json.size() <= 6000
        && request.resource.data.ts is number;
    }
  }
}
